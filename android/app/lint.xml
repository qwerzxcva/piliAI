<?xml version="1.0" encoding="utf-8"?>
<!--
  审核：Lint 配置——针对以下「已知且无害」的项关闭（均为 Flutter 移植遗留的资源形态，
  非代码缺陷；其余问题一律保持 default 严格级别）。
-->
<lint>
    <!-- 启动图惯用 densityless 目录（Flutter 模板），改密度目录会破坏现有资源布局 -->
    <issue id="IconLocation" severity="ignore" />
    <!-- 启动图 splash 与 launcher icon 恰为同图（模板默认），非误用 -->
    <issue id="IconDuplicates" severity="ignore" />
    <issue id="IconDuplicatesConfig" severity="ignore" />
    <!-- Media3 播放器 10s 快进/快退矢量图路径较长，属第三方图标资源，保持原样 -->
    <issue id="VectorPath" severity="ignore" />
    <!-- NormalTheme 由系统在部分场景引用，静态分析判为 unused 属误报 -->
    <issue id="UnusedResources" severity="warning" />
    <!--
      策略类提示（非缺陷）：AGP/Gradle 与 targetSdk 的“有新版本可用”属于升级提示，
      本项目当前锁定 AGP 8.5.2 + targetSdk 34（与 Kotlin 2.0.21/Compose/KSP 对齐）。
      升级 AGP/compileSdk 需同步升级 JDK 与 Compose 编译插件，风险高于收益，
      因此在此基线忽略；真实代码问题（UnusedResources 等）仍会令门禁失败。
    -->
    <issue id="OldTargetApi" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <issue id="GradleDependency" severity="ignore" />

    <!--
      Kotlin 2.2.21 升级后确认的 lint 误报（RememberReturnType）：
        VideoPlayerScreen 的 `remember { HashSet<String>() }` 实际返回
        MutableSet<String>（非 Unit），但 lint 仍报 "must not return Unit"。
      已实测三种写法均误报：
        1) remember { mutableSetOf<String>() }
        2) val x: MutableSet<String> = remember { mutableSetOf() }
        3) val x: MutableSet<String> = remember { HashSet() }
      规则本意是拦截 remember 返回 Unit（无缓存意义），此处返回集合，
      属规则误判，故基线忽略；其余 Error/Warning 仍会令构建失败。
    -->
    <issue id="RememberReturnType" severity="ignore" />

    <!--
      第三方 lint registry 版本提示（非本项目代码问题）：
      androidx.annotation 的 ExperimentalIssueRegistry 要求更新的 lint API。
      随 Kotlin 2.2.21 升级暴露（lint 版本随 AGP 8.5.2 固定）。
      修复需升级 AGP（会牵动 Kotlin/Compose/JDK 整条链），风险高于收益，
      故基线忽略；真实代码问题仍会令构建失败。
    -->
    <issue id="ObsoleteLintCustomCheck" severity="ignore" />

    <!--
      ModifierParameter 降级为 info（不阻塞 CI）：
      该规则要求 modifier 参数在第一位，但本项目大量 Composable 函数
      将业务参数（items/onClick 等）放在 modifier 前，属常见写法。
      规则本意是提醒「modifier 应该可选且靠前」，此处业务参数优先
      更符合调用习惯，故降级为 info 不阻塞构建。
    -->
    <issue id="ModifierParameter" severity="info" />

    <!--
      审核318：本地化红线。MissingTranslation 默认已是 error，这里显式固化，
      配合 tests/check_lint_report.py 按 severity 判定：任何新增未翻译字符串
      都会让 CI 红，从源头止住 values-en 与 values 悄悄漂移。
    -->
    <issue id="MissingTranslation" severity="fatal" />
</lint>
